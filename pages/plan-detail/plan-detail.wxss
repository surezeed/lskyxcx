/* 渐变头部 —— VIP 金色 */
.plan-hero {
  position: relative;
  margin: 24rpx;
  border-radius: 36rpx;
  padding: 60rpx 44rpx;
  overflow: hidden;
}
.hero-vip {
  background: linear-gradient(160deg, #f59e0b 0%, #f97316 55%, #F43F5E 100%);
  box-shadow: 0 16rpx 40rpx rgba(245, 158, 11, 0.3);
}
.hero-storage {
  background: linear-gradient(135deg, #4D6BFE 0%, #7C5CFC 55%, #8B5CF6 100%);
  box-shadow: 0 16rpx 40rpx rgba(77, 107, 254, 0.3);
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.blob-1 {
  width: 320rpx;
  height: 320rpx;
  top: -120rpx;
  right: -100rpx;
}
.blob-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -70rpx;
  left: -60rpx;
}
.hero-label {
  position: relative;
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 26rpx;
  padding: 10rpx 28rpx;
  letter-spacing: 2rpx;
}
.hero-badge {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 24rpx;
  padding: 10rpx 26rpx;
  font-weight: 600;
}
.hero-name {
  position: relative;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-top: 26rpx;
}
.hero-intro {
  position: relative;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 24rpx;
  line-height: 1.6;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

/* 权益 */
.feature-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.check {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #E7F8F2;
  color: #10B981;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.check-gold {
  background: #FEF4E2;
  color: #d97706;
}
.feature-text {
  font-size: 27rpx;
  color: #4b5563;
}

/* 网页端提示 */
.web-tip {
  text-align: center;
  color: #9AA1B2;
  font-size: 23rpx;
  padding: 36rpx 60rpx 60rpx;
  line-height: 1.7;
}

.check { display: flex; align-items: center; justify-content: center; }
.check-ic { width: 24rpx; height: 24rpx; }
.hero-label { display: inline-flex; align-items: center; }
.hero-label-ic { width: 26rpx; height: 26rpx; margin-right: 8rpx; }

<view class="page-theme {{theme}}">
<view class="page">
  <view class="top-bar">
    <view class="top-title">
      <text class="top-name">工单反馈</text>
      <text class="top-desc">遇到问题或有建议?提交工单联系我们</text>
    </view>
    <view class="add-btn" bindtap="toggleForm">{{showForm ? '收起' : '+ 提交'}}</view>
  </view>

  <!-- 创建表单 -->
  <view class="card" wx:if="{{showForm}}">
    <view class="form-item">
      <text class="form-label">标题</text>
      <input class="form-input" placeholder="简要描述问题" placeholder-class="ph"
             value="{{title}}" data-field="title" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">优先级</text>
      <picker range="{{levelNames}}" value="{{levelIndex}}" bindchange="onLevel">
        <view class="picker-value">{{levelNames[levelIndex]}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">内容</text>
      <textarea class="form-textarea" placeholder="请详细描述遇到的问题..." placeholder-class="ph"
                value="{{content}}" data-field="content" bindinput="onInput" auto-height />
    </view>
    <button class="btn-primary" loading="{{creating}}" disabled="{{creating}}" bindtap="create">提交工单</button>
  </view>

  <!-- 工单列表 -->
  <view wx:if="{{tickets.length}}" class="ticket-list">
    <view class="card ticket-item" wx:for="{{tickets}}" wx:key="issueNo"
          data-no="{{item.issueNo}}" bindtap="openDetail">
      <view class="ticket-head">
        <view class="level-badge {{item.levelCls}}">{{item.levelLabel}}</view>
        <view class="closed-badge" wx:if="{{item.closed}}">已关闭</view>
        <view class="ticket-time">{{item.createdAt}}</view>
      </view>
      <view class="ticket-title">{{item.title}}</view>
      <view class="ticket-no">工单号 {{item.issueNo}}</view>
      <view class="ticket-arrow">›</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <image class="empty-icon" src="/images/li/ticket-gray.png" />
    <view>还没有提交过工单</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <view wx:elif="{{!hasMore && tickets.length}}" class="loading-tip">— 没有更多了 —</view>
</view>
</view>

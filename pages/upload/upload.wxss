.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F2F4F9;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
}
.switch-title {
  font-size: 28rpx;
  font-weight: 500;
}
.switch-desc {
  font-size: 22rpx;
  color: #9AA1B2;
  margin-top: 6rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.head-title {
  font-size: 28rpx;
  font-weight: 600;
}
.head-link {
  font-size: 24rpx;
  color: #4D6BFE;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-cell {
  width: 25%;
  padding: 8rpx;
  box-sizing: border-box;
  position: relative;
}
.thumb {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  background: #eef0f6;
  display: block;
}
.mask {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 0;
  height: 150rpx;
  border-radius: 16rpx;
  background: rgba(25, 28, 43, 0.5);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}
.mask-done {
  background: rgba(34, 197, 94, 0.65);
}
.mask-fail {
  background: rgba(244, 63, 94, 0.65);
}
.remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(25, 28, 43, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  z-index: 2;
}
.add-cell {
  height: 150rpx;
  margin-top: 8rpx;
  border: 3rpx dashed #C6CBDD;
  border-radius: 16rpx;
  color: #9AA1B2;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.choose-area {
  text-align: center;
  color: #9AA1B2;
  font-size: 26rpx;
  padding: 70rpx 0;
  border: 3rpx dashed #C6CBDD;
  border-radius: 24rpx;
  background: #F8F9FE;
}
.choose-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}
.upload-tip {
  text-align: center;
  color: #9AA1B2;
  font-size: 22rpx;
  margin-top: 22rpx;
}

.mask-ic { width: 26rpx; height: 26rpx; margin-right: 8rpx; }

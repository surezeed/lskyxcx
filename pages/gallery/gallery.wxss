/* 玻璃吸顶工具条 */
.toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.92);
  padding: 24rpx 24rpx 20rpx;
  border-radius: 0 0 36rpx 36rpx;
  border-bottom: 1rpx solid rgba(238, 240, 246, 0.9);
  box-shadow: 0 4rpx 16rpx rgba(25, 28, 43, 0.04);
}
@supports (-webkit-backdrop-filter: blur(1rpx)) {
  .toolbar {
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(32rpx) saturate(160%);
    backdrop-filter: blur(32rpx) saturate(160%);
  }
}
/* 滚动加深投影（配合页面 JS 叠加 .scrolled） */
.toolbar.scrolled {
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 43, 0.12);
}
.search-box {
  display: flex;
  align-items: center;
  background: #F2F4F9;
  border-radius: 999rpx;
  padding: 0 12rpx 0 26rpx;
  height: 84rpx;
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 78rpx;
}
.ph {
  color: #9AA1B2;
}
.search-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #4D6BFE, #7C5CFC);
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(77, 107, 254, 0.3);
}
.filter-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.chip {
  font-size: 22rpx;
  color: #5C6374;
  background: #F2F4F9;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  transition: all 0.2s;
}
.chip-active {
  color: #4D6BFE;
  background: rgba(77, 107, 254, 0.1);
  border: 1rpx solid rgba(77, 107, 254, 0.35);
  font-weight: 600;
}
.count {
  margin-left: auto;
  font-size: 22rpx;
  color: #9AA1B2;
}

/* 两列大图网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}
.cell {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}
.img-wrap {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(25, 28, 43, 0.06);
}
.img {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #EEF0F6;
}
/* 公开角标：毛玻璃胶囊（小面积，限制 blur16） */
.public-badge {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  background: rgba(25, 28, 43, 0.35);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  color: #fff;
  font-size: 18rpx;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.cell-name {
  font-size: 22rpx;
  color: #9AA1B2;
  margin: 10rpx 4rpx 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 悬浮 tabBar 底部留白 */
/* 底部留白放在主题根节点内,随主题变色 */
.page-theme {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

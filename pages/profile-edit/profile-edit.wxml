<view class="page-theme {{theme}}">
<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">个性签名</text>
      <input class="form-input" value="{{form.tagline}}" data-field="tagline" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">个人简介</text>
      <textarea class="form-textarea" value="{{form.bio}}" data-field="bio"
                bindinput="onInput" auto-height />
    </view>
    <view class="form-item">
      <text class="form-label">个人主页</text>
      <input class="form-input" value="{{form.url}}" data-field="url" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">所在位置</text>
      <input class="form-input" value="{{form.location}}" data-field="location" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">公司</text>
      <input class="form-input" value="{{form.company}}" data-field="company" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">公司职称</text>
      <input class="form-input" value="{{form.company_title}}" data-field="company_title" bindinput="onInput" />
    </view>
    <button class="btn-primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</view>
</view>

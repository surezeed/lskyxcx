/* ============ 全局设计系统 v2.0（玻璃拟态 · 大留白 · 细腻渐变） ============ */
page {
  /* 底色交给窗口背景(app.json/ wx.setBackgroundColor 按主题同步),
     避免 page 自身亮底在顶部 margin 塌陷区与底部 padding 区露出 */
  color: #191C2B;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
}

/* 页面顶部氛围光斑（加在每页首个节点） */
.bg-mesh {
  position: fixed;
  top: -200rpx;
  left: -100rpx;
  right: -100rpx;
  height: 560rpx;
  background:
    radial-gradient(320rpx 320rpx at 20% 20%, rgba(77, 107, 254, 0.12), rgba(77, 107, 254, 0) 70%),
    radial-gradient(360rpx 360rpx at 85% 10%, rgba(139, 92, 246, 0.12), rgba(139, 92, 246, 0) 70%);
  pointer-events: none;
  z-index: 0;
}

/* 玻璃拟态 Token（含低端机降级：先纯半透明底，支持时再叠模糊） */
.glass {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 10rpx 32rpx rgba(25, 28, 43, 0.07);
}
@supports (-webkit-backdrop-filter: blur(1rpx)) {
  .glass {
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(32rpx) saturate(160%);
    backdrop-filter: blur(32rpx) saturate(160%);
  }
}

/* 吸顶加深投影（滚动时由页面叠加 .scrolled） */
.scrolled {
  box-shadow: 0 12rpx 32rpx rgba(25, 28, 43, 0.12);
}

/* 图片按压反馈（配合 hover-class="img-press"） */
.img-press {
  transform: scale(1.02);
  transition: transform 0.2s ease;
}

/* 通用卡片（玻璃底 + shadow-md + R28） */
.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 10rpx 32rpx rgba(25, 28, 43, 0.07);
}
@supports (-webkit-backdrop-filter: blur(1rpx)) {
  .card {
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(24rpx) saturate(150%);
    backdrop-filter: blur(24rpx) saturate(150%);
  }
}

/* 区块标题（带渐变竖条） */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 32rpx 20rpx;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #191C2B;
}
.section-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4D6BFE, #8B5CF6);
  margin-right: 16rpx;
}
.section-more {
  font-size: 24rpx;
  color: #9AA1B2;
}

/* 主按钮：渐变胶囊 + 投影 */
.btn-primary {
  background: linear-gradient(135deg, #4D6BFE 0%, #7C5CFC 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  height: 88rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(77, 107, 254, 0.3);
}
.btn-primary[disabled] {
  background: #C6CBDD;
  color: #ffffff;
  box-shadow: none;
}
.btn-plain {
  background: rgba(255, 255, 255, 0.85);
  color: #4D6BFE;
  border: 1rpx solid #D8DFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 86rpx;
  height: 88rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  font-size: 25rpx;
  color: #9AA1B2;
  margin-bottom: 14rpx;
  display: block;
}

/* 彩色图标底块（全局通用 · 淡彩新色板） */
.tile-blue { background: #EAF1FF; }
.tile-violet { background: #F1EBFF; }
.tile-green { background: #E7F8F2; }
.tile-orange { background: #FFF3E0; }
.tile-red { background: #FEECEF; }
.tile-gold { background: #FEF6E2; }
.tile-cyan { background: #E4FAFF; }

/* 页面容器（全局通用） */
.page {
  padding: 24rpx 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  align-items: center;
  background: #F2F4F9;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.block-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #191C2B;
  margin-bottom: 24rpx;
}
.block-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4D6BFE, #8B5CF6);
  margin-right: 14rpx;
}

.form-input {
  background: #F2F4F9;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  height: 88rpx;
  box-sizing: border-box;
  color: #191C2B;
  border: 2rpx solid transparent;
}
.form-textarea {
  background: #F2F4F9;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  width: auto;
  min-height: 160rpx;
  box-sizing: border-box;
  color: #191C2B;
  border: 2rpx solid transparent;
}
.form-input:focus,
.form-textarea:focus {
  border: 2rpx solid #4D6BFE;
  box-shadow: 0 0 0 8rpx rgba(77, 107, 254, 0.1);
}
.picker-value {
  background: #F2F4F9;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #191C2B;
  position: relative;
  padding-right: 64rpx;
}
.picker-value::after {
  content: "›";
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #C6CBDD;
  font-size: 34rpx;
}

/* 空状态（玻璃圆卡 + 淡渐变图标底） */
.empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #9AA1B2;
  font-size: 27rpx;
}
.empty-icon {
  background: radial-gradient(120% 120% at 30% 20%, #EEF1FF 0%, #F8F5FF 100%);
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(77, 107, 254, 0.1);
}
.empty-btn {
  margin-top: 44rpx;
  width: 340rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  color: #9AA1B2;
  font-size: 24rpx;
  padding: 28rpx 0 44rpx;
}

/* 标签/Chip */
.tag {
  display: inline-block;
  background: rgba(77, 107, 254, 0.1);
  color: #4D6BFE;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
}

/* 彩色图标块 */
.icon-tile {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

/* ===== 线性图标(图片) ===== */
.tile-ic { width: 42rpx; height: 42rpx; }
.chip-ic { width: 26rpx; height: 26rpx; margin-right: 6rpx; vertical-align: -4rpx; }
.action-ic { width: 24rpx; height: 24rpx; margin-right: 6rpx; vertical-align: -3rpx; }
.empty-icon { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; }

/* ============ 明暗主题(全局) ============
   页面根节点: <view class="page-theme {{theme}}">,theme 由 app.js 注入
   暗色板:bg #0B0C12 / 卡 #14161F / 输入 #1D2030 / 墨 #F5F6FA·#B4BAC8·#6E7484 / 线 #262A38 */
.page-theme {
  background: #F4F5FA;
  color: #191C2B;
  min-height: 100vh;
  /* 1rpx 内边距阻断首子元素 margin-top 塌陷穿透根节点(顶部亮带根源) */
  padding-top: 1rpx;
  box-sizing: border-box;
}
.page-theme.dark {
  background: #0B0C12;
  color: #F5F6FA;
}

/* ---- 卡片/玻璃面 ---- */
.page-theme.dark .card,
.page-theme.dark .glass,
.page-theme.dark .toc,
.page-theme.dark .stats-card {
  background: #14161F;
  border-color: #262A38;
  box-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* ---- 表单 ---- */
.page-theme.dark .form-input,
.page-theme.dark .form-textarea,
.page-theme.dark .picker-value,
.page-theme.dark .form-row {
  background: #1D2030;
  color: #F5F6FA;
}
.page-theme.dark .picker-value::after { color: #4A4F60; }

/* ---- 主文字 → 亮墨 ---- */
.page-theme.dark .section-title,
.page-theme.dark .block-title,
.page-theme.dark .toc-title,
.page-theme.dark .toc-name,
.page-theme.dark .display-title,
.page-theme.dark .folio-num,
.page-theme.dark .menu-text,
.page-theme.dark .rank-title,
.page-theme.dark .rank-list-title,
.page-theme.dark .row-label,
.page-theme.dark .row-value,
.page-theme.dark .toc-hover,
.page-theme.dark .type-opt-active {
  color: #F5F6FA;
}

/* ---- 次级文字 ---- */
.page-theme.dark .mast-name-sm,
.page-theme.dark .strip-name,
.page-theme.dark .feat-sub-dark,
.page-theme.dark .menu-value {
  color: #B4BAC8;
}

/* ---- 弱文字 → 暗灰 ---- */
.page-theme.dark .section-more,
.page-theme.dark .form-label,
.page-theme.dark .empty,
.page-theme.dark .loading-tip,
.page-theme.dark .cell-name,
.page-theme.dark .count,
.page-theme.dark .footer,
.page-theme.dark .mq-txt,
.page-theme.dark .n-txt,
.page-theme.dark .folio-label,
.page-theme.dark .stat-label,
.page-theme.dark .toc-en,
.page-theme.dark .cta-note,
.page-theme.dark .rank-list-en,
.page-theme.dark .load-more,
.page-theme.dark .empty-text,
.page-theme.dark .row-placeholder,
.page-theme.dark .deck-pager-total,
.page-theme.dark .deck-pager-sep,
.page-theme.dark .mast-meta-l,
.page-theme.dark .mast-meta-r,
.page-theme.dark .mast-group,
.page-theme.dark .type-opt,
.page-theme.dark .toc-arrow,
.page-theme.dark .menu-arrow,
.page-theme.dark .row-arrow {
  color: #6E7484;
}

/* ---- 分割线/边框 ---- */
.page-theme.dark .mast-meta,
.page-theme.dark .marquee,
.page-theme.dark .folio,
.page-theme.dark .rank-head-txt,
.page-theme.dark .toc-item {
  border-color: #262A38;
}
.page-theme.dark .folio-rule,
.page-theme.dark .stat-divider {
  background: #262A38;
}

/* ---- 芯片/搜索/工具条 ---- */
.page-theme.dark .toolbar {
  background: rgba(11, 12, 18, 0.92);
  border-bottom-color: #1D2030;
}
.page-theme.dark .search-box,
.page-theme.dark .chip,
.page-theme.dark .type-toggle,
.page-theme.dark .picker-row {
  background: #1D2030;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.35);
}
.page-theme.dark .search-input { color: #F5F6FA; }
.page-theme.dark .ph, .page-theme.dark .search-ph { color: #6E7484; }
.page-theme.dark .chip-active {
  color: #8FA2FF;
  background: rgba(107, 133, 255, 0.14);
  border-color: rgba(107, 133, 255, 0.4);
}
.page-theme.dark .search-open {
  background: rgba(20, 22, 31, 0.94);
  border-color: #262A38;
}
.page-theme.dark .search-open-input { color: #F5F6FA; }

/* ---- 杂项组件 ---- */
.page-theme.dark .tag {
  color: #8FA2FF;
  background: rgba(107, 133, 255, 0.15);
}
.page-theme.dark .btn-plain {
  background: #1D2030;
  color: #8FA2FF;
  border-color: #2A3050;
}
.page-theme.dark .empty-icon {
  background: radial-gradient(120% 120% at 30% 20%, #1D2338 0%, #241E3E 100%);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.35);
}
.page-theme.dark .img,
.page-theme.dark .strip-img,
.page-theme.dark .strip-item {
  background: #1D2030;
}
.page-theme.dark .strip-item { box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35); }
.page-theme.dark .deck-left,
.page-theme.dark .deck-right { background: #1D2030; }
.page-theme.dark .capsule {
  background: rgba(20, 22, 31, 0.9);
  border-color: #262A38;
}
.page-theme.dark .icon-tile { box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.08); }
.page-theme.dark .type-opt-active { background: #2A3050; }
.page-theme.dark .head-pill { box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4); }
